<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mg_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título enxuto; mesma paleta escura e roxa da timeline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btnVoltar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="‹  Voltar"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/mg_accent_light"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meu perfil"
                android:textColor="@color/mg_text"
                android:textStyle="bold"
                android:textSize="18sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mg_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="18dp">

            <ImageView
                android:id="@+id/fotoPerfil"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_mg_avatar"
                android:clipToOutline="true"
                android:src="@drawable/ic_mg_profile"
                android:contentDescription="Foto do perfil" />

            <Button
                android:id="@+id/btnEscolherFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Alterar foto"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/txtContador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="0 publicações"
                android:textColor="@color/mg_subtle"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:text="Apelido"
                android:textColor="@color/mg_text"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/campoApelido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Como você quer aparecer no MiniGram?"
                android:inputType="textPersonName"
                android:maxLength="24"
                android:singleLine="true"
                android:textColor="@color/mg_text"
                android:textColorHint="@color/mg_subtle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Biografia"
                android:textColor="@color/mg_text"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/campoBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Conte um pouco sobre você..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="120"
                android:minLines="2"
                android:maxLines="4"
                android:gravity="top|start"
                android:textColor="@color/mg_text"
                android:textColorHint="@color/mg_subtle" />

            <Button
                android:id="@+id/btnSalvarPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/mg_purple"
                android:textColor="@color/mg_text"
                android:textAllCaps="false"
                android:text="Salvar perfil" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="As suas publicações continuam na tela inicial."
                android:textColor="@color/mg_subtle"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
